---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/ko/' | absolute_url }}</loc></url>
  <url><loc>{{ '/notes/' | absolute_url }}</loc></url>
  <url><loc>{{ '/ko/notes/' | absolute_url }}</loc></url>
  {%- assign note_pages = site.pages | where: 'layout', 'note' -%}
  {%- for page in note_pages %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    {%- if page.date %}
    <lastmod>{{ page.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
    {%- if page.image %}
    <image:image><image:loc>{{ page.image | absolute_url }}</image:loc></image:image>
    {%- endif %}
    {%- if page.story %}
      {%- for item in page.story %}
    <image:image><image:loc>{{ item.image | absolute_url }}</image:loc></image:image>
      {%- endfor %}
    {%- endif %}
  </url>
  {%- endfor %}
  <url><loc>{{ '/kitchen/' | absolute_url }}</loc></url>
  <url><loc>{{ '/ko/kitchen/' | absolute_url }}</loc></url>
  {%- assign kitchen_pages = site.pages | where: 'layout', 'kitchen' -%}
  {%- for page in kitchen_pages %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    {%- if page.date %}
    <lastmod>{{ page.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
    {%- if page.image %}
    <image:image><image:loc>{{ page.image | absolute_url }}</image:loc></image:image>
    {%- endif %}
    {%- if page.story %}
      {%- for item in page.story %}
    <image:image><image:loc>{{ item.image | absolute_url }}</image:loc></image:image>
      {%- endfor %}
    {%- endif %}
  </url>
  {%- endfor %}
  <url><loc>{{ '/places/' | absolute_url }}</loc></url>
  <url><loc>{{ '/ko/places/' | absolute_url }}</loc></url>
  {%- assign place_pages = site.pages | where: 'layout', 'place' -%}
  {%- for page in place_pages %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    {%- if page.date %}
    <lastmod>{{ page.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
    {%- if page.image %}
    <image:image><image:loc>{{ page.image | absolute_url }}</image:loc></image:image>
    {%- endif %}
    {%- if page.story %}
      {%- for item in page.story %}
    <image:image><image:loc>{{ item.image | absolute_url }}</image:loc></image:image>
      {%- endfor %}
    {%- endif %}
  </url>
  {%- endfor %}
</urlset>
