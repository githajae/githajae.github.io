rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'googlhajae@gmail.com',
          'yshajae@postech.ac.kr',
          'jhha@dblab.postech.ac.kr'
        ];
    }

    function validText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function validCommentScope() {
      let scope = request.resource.data.get('scope', 'paragraph');
      return (
          scope == 'article'
          && request.resource.data.quote == ''
          && request.resource.data.prefix == ''
          && request.resource.data.suffix == ''
          && request.resource.data.start == 0
          && request.resource.data.end == 0
        ) || (
          scope == 'paragraph'
          && validText(request.resource.data.quote, 500)
          && request.resource.data.prefix is string
          && request.resource.data.prefix.size() <= 128
          && request.resource.data.suffix is string
          && request.resource.data.suffix.size() <= 128
          && request.resource.data.start is int
          && request.resource.data.start >= 0
          && request.resource.data.end is int
          && request.resource.data.end > request.resource.data.start
        );
    }

    function validAnnotation(articleId) {
      return request.resource.data.keys().hasOnly([
          'articleId', 'revision', 'language',
          'scope', 'quote', 'prefix', 'suffix', 'start', 'end',
          'body', 'authorId', 'authorName',
          'createdAt', 'updatedAt', 'resolved', 'hidden',
          'editCount', 'lastEditId'
        ])
        && request.resource.data.articleId == articleId
        && validText(request.resource.data.revision, 80)
        && request.resource.data.language in ['en', 'ko']
        && validCommentScope()
        && validText(request.resource.data.body, 2000)
        && request.resource.data.authorId == request.auth.uid
        && validText(request.resource.data.authorName, 80)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.resolved == false
        && request.resource.data.hidden == false
        && request.resource.data.get('editCount', 0) == 0
        && request.resource.data.get('lastEditId', '') == '';
    }

    function annotationVisible(articleId, annotationId) {
      return get(/databases/$(database)/documents/articles/$(articleId)/annotations/$(annotationId)).data.hidden == false;
    }

    function annotationOpen(articleId, annotationId) {
      let annotation = get(/databases/$(database)/documents/articles/$(articleId)/annotations/$(annotationId));
      return annotation.data.hidden == false && annotation.data.resolved == false;
    }

    function validHistoryDocument(history, version, previousBody) {
      return history.keys().hasOnly(['body', 'editedAt', 'version'])
        && history.body == previousBody
        && validText(history.body, 2000)
        && history.editedAt == request.time
        && history.version == version;
    }

    function validAnnotationEdit(articleId, annotationId) {
      let previousVersion = resource.data.get('editCount', 0);
      let nextVersion = previousVersion + 1;
      let historyId = request.resource.data.lastEditId;
      let historyPath = /databases/$(database)/documents/articles/$(articleId)/annotations/$(annotationId)/history/$(historyId);
      return signedIn()
        && resource.data.authorId == request.auth.uid
        && resource.data.hidden == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'body', 'updatedAt', 'editCount', 'lastEditId'
        ])
        && validText(request.resource.data.body, 2000)
        && request.resource.data.body != resource.data.body
        && request.resource.data.updatedAt == request.time
        && request.resource.data.editCount == nextVersion
        && validText(historyId, 128)
        && existsAfter(historyPath)
        && validHistoryDocument(getAfter(historyPath).data, nextVersion, resource.data.body);
    }

    function validReplyEdit(articleId, annotationId, replyId) {
      let previousVersion = resource.data.get('editCount', 0);
      let nextVersion = previousVersion + 1;
      let historyId = request.resource.data.lastEditId;
      let historyPath = /databases/$(database)/documents/articles/$(articleId)/annotations/$(annotationId)/replies/$(replyId)/history/$(historyId);
      return signedIn()
        && resource.data.authorId == request.auth.uid
        && resource.data.hidden == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'body', 'updatedAt', 'editCount', 'lastEditId'
        ])
        && validText(request.resource.data.body, 2000)
        && request.resource.data.body != resource.data.body
        && request.resource.data.updatedAt == request.time
        && request.resource.data.editCount == nextVersion
        && validText(historyId, 128)
        && existsAfter(historyPath)
        && validHistoryDocument(getAfter(historyPath).data, nextVersion, resource.data.body);
    }

    function validAnnotationHistory(articleId, annotationId, historyId) {
      let annotationPath = /databases/$(database)/documents/articles/$(articleId)/annotations/$(annotationId);
      return signedIn()
        && get(annotationPath).data.authorId == request.auth.uid
        && get(annotationPath).data.hidden == false
        && getAfter(annotationPath).data.lastEditId == historyId
        && validHistoryDocument(
          request.resource.data,
          getAfter(annotationPath).data.editCount,
          get(annotationPath).data.body
        );
    }

    function validReplyHistory(articleId, annotationId, replyId, historyId) {
      let replyPath = /databases/$(database)/documents/articles/$(articleId)/annotations/$(annotationId)/replies/$(replyId);
      return signedIn()
        && get(replyPath).data.authorId == request.auth.uid
        && get(replyPath).data.hidden == false
        && getAfter(replyPath).data.lastEditId == historyId
        && validHistoryDocument(
          request.resource.data,
          getAfter(replyPath).data.editCount,
          get(replyPath).data.body
        );
    }

    match /articles/{articleId}/annotations/{annotationId} {
      allow get, list: if resource.data.hidden == false || isOwner();
      allow create: if signedIn() && validAnnotation(articleId);
      allow update: if (
          isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'resolved', 'hidden', 'updatedAt'
          ])
          && request.resource.data.resolved is bool
          && request.resource.data.hidden is bool
          && request.resource.data.updatedAt == request.time
        ) || validAnnotationEdit(articleId, annotationId);

      match /history/{historyId} {
        allow get, list: if isOwner();
        allow create: if validAnnotationHistory(articleId, annotationId, historyId);
      }

      match /replies/{replyId} {
        allow get, list: if (resource.data.hidden == false && annotationVisible(articleId, annotationId)) || isOwner();
        allow create: if signedIn()
          && annotationOpen(articleId, annotationId)
          && request.resource.data.keys().hasOnly([
            'body', 'authorId', 'authorName', 'createdAt', 'updatedAt', 'hidden',
            'editCount', 'lastEditId'
          ])
          && validText(request.resource.data.body, 2000)
          && request.resource.data.authorId == request.auth.uid
          && validText(request.resource.data.authorName, 80)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.hidden == false
          && request.resource.data.get('editCount', 0) == 0
          && request.resource.data.get('lastEditId', '') == '';
        allow update: if (
            isOwner()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'hidden', 'updatedAt'
            ])
            && request.resource.data.hidden is bool
            && request.resource.data.updatedAt == request.time
          ) || validReplyEdit(articleId, annotationId, replyId);

        match /history/{historyId} {
          allow get, list: if isOwner();
          allow create: if validReplyHistory(articleId, annotationId, replyId, historyId);
        }
      }
    }
  }
}
